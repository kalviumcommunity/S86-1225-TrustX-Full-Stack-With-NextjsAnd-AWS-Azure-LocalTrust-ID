# =====================
# Server-side variables
# =====================

# Database Configuration
# ----------------------
# Local PostgreSQL (Development)
# DATABASE_URL=postgresql://username:password@localhost:5432/trustxdb?schema=public

# AWS RDS PostgreSQL (Production)
# DATABASE_URL=postgresql://adminuser:YOUR_PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/trustxdb?schema=public&sslmode=require

# Azure Database for PostgreSQL (Production)
# DATABASE_URL=postgresql://adminuser:YOUR_PASSWORD@your-server.postgres.database.azure.com:5432/trustxdb?schema=public&sslmode=require

# Choose one based on your cloud provider:
DATABASE_URL=postgresql://username:password@localhost:5432/trustxdb?schema=public

# Direct URL (for migrations on serverless platforms like Vercel)
# This is required when using connection pooling services like PgBouncer
# DIRECT_URL=postgresql://adminuser:YOUR_PASSWORD@your-rds-endpoint:5432/trustxdb?schema=public&sslmode=require

# JWT Configuration
# IMPORTANT: Use strong random strings in production (64+ characters recommended)
# Generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Optional: Token expiry times (defaults: 15m for access, 7d for refresh)
# JWT_EXPIRY=15m
# REFRESH_TOKEN_EXPIRY=7d

# Redis Configuration
# For local Redis server
REDIS_URL=redis://localhost:6379
# For Redis Cloud or managed Redis
# REDIS_URL=redis://username:password@host:port
# For Redis with authentication
# REDIS_URL=redis://:password@localhost:6379

# Environment
NODE_ENV=development

# =====================
# Email Service Configuration (SendGrid)
# =====================
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_SENDER=noreply@yourdomain.com

# =====================
# Object Storage Configuration
# =====================
# Choose your storage provider: 'aws' or 'azure'
STORAGE_PROVIDER=aws

# AWS S3 Configuration
# --------------------
# Get credentials from AWS Console → IAM → Users
# Or run: ./scripts/setup-aws-s3.sh
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Azure Blob Storage Configuration
# ---------------------------------
# Get credentials from Azure Portal → Storage Accounts
# Or run: ./scripts/setup-azure-blob.sh
# AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
# AZURE_STORAGE_CONTAINER_NAME=uploads
# AZURE_STORAGE_ACCOUNT_KEY=your-account-key
# AZURE_STORAGE_CONNECTION_STRING=your-connection-string

# ============================================================================
# Secrets Manager Configuration (PRODUCTION)
# ============================================================================
# For secure cloud-based secret management
# Run setup scripts to automatically configure:
#   - AWS: ./scripts/setup-aws-secrets.sh
#   - Azure: ./scripts/setup-azure-keyvault.sh

# AWS Secrets Manager
# -------------------
# USE_SECRETS_MANAGER=true
# SECRET_NAME=nextjs/trustx-app-secrets
# SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789:secret:nextjs/trustx-app-secrets
# AWS_REGION=us-east-1

# Azure Key Vault
# ---------------
# USE_KEY_VAULT=true
# KEYVAULT_NAME=kv-trustx-app
# AZURE_TENANT_ID=your-tenant-id

# For Service Principal Authentication (optional):
# AZURE_CLIENT_ID=your-app-id
# AZURE_CLIENT_SECRET=your-secret

# For Managed Identity (recommended for Azure App Service):
# Leave AZURE_CLIENT_ID and AZURE_CLIENT_SECRET empty
# Managed Identity will be used automatically

# =====================
# Client-side variables
# =====================
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
