{
  "name": "trust-x",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "lint": "eslint .",
    "prepare": "husky install",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:integration": "jest --config jest.integration.config.js",
    "test:integration:watch": "jest --config jest.integration.config.js --watch",
    "test:integration:coverage": "jest --config jest.integration.config.js --coverage",
    "test:smoke": "jest --testPathPattern=__smoke_tests__ --runInBand --forceExit",
    "test:all": "npm test && npm run test:integration",
    "test:cache": "node cache-test.js",
    "test:db": "node scripts/test-db-connection.js",
    "test:upload": "node scripts/test-upload.js",
    "db:health": "curl http://localhost:3000/api/health/db?detailed=true",
    "storage:health": "curl http://localhost:3000/api/upload/health",
    "secrets:health": "curl http://localhost:3000/api/health/secrets",
    "secrets:refresh": "curl -X POST http://localhost:3000/api/health/secrets/refresh",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.956.0",
    "@aws-sdk/client-secrets-manager": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.956.0",
    "@azure/identity": "^4.13.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@azure/storage-blob": "^12.29.1",
    "@hookform/resolvers": "^5.2.2",
    "@sendgrid/mail": "^8.1.6",
    "@types/dompurify": "^3.0.5",
    "@types/sanitize-html": "^2.16.0",
    "bcrypt": "^6.0.0",
    "dompurify": "^3.3.1",
    "ioredis": "^5.8.2",
    "isomorphic-dompurify": "^2.35.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.0.10",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.69.0",
    "react-hot-toast": "^2.4.0",
    "sanitize-html": "^2.17.0",
    "swr": "^2.3.8",
    "validator": "^13.15.26",
    "xss": "^1.0.15",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@prisma/client": "^6.19.1",
    "@storybook/addon-a11y": "^10.1.10",
    "@storybook/addon-docs": "^10.1.10",
    "@storybook/addon-onboarding": "^10.1.10",
    "@storybook/addon-vitest": "^10.1.10",
    "@storybook/nextjs": "^10.1.10",
    "@storybook/react": "^10.1.10",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.3",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "eslint-config-prettier": "^9",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-storybook": "^10.1.10",
    "husky": "^9",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15",
    "msw": "^2.12.7",
    "node-fetch": "^3.3.2",
    "node-mocks-http": "^1.17.2",
    "playwright": "^1.57.0",
    "prettier": "^3",
    "prisma": "^6.19.1",
    "storybook": "^10.1.10",
    "supertest": "^7.2.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
